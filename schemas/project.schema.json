{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmint.mission_control.project.v1",
  "title": "Mission Control project",
  "description": "Time-bounded deliverable belonging to a team. Linear: Project.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "team_id",
    "owner",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentmint.mission_control.project.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^proj-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "backlog",
        "planned",
        "in_progress",
        "paused",
        "completed",
        "canceled"
      ]
    },
    "owner": { "type": "string", "minLength": 1 },
    "team_id": {
      "type": "string",
      "pattern": "^team-[a-z][a-z0-9-]*$"
    },
    "initiative_id": {
      "type": "string",
      "pattern": "^init-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "starts_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "target_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^label-[a-z][a-z0-9-]*$"
      }
    },
    "planning_source": {
      "type": "object",
      "properties": {
        "plan_id": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
