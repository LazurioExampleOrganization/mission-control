{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmint.mission_control.triage_item.v1",
  "title": "Mission Control triage item (intake)",
  "description": "Intake item awaiting triage. Linear: Triage. Promoted to issue or rejected.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "source",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentmint.mission_control.triage_item.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^tri-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["open", "triaged", "rejected", "duplicate", "deferred"]
    },
    "source": {
      "enum": ["agent", "person", "automation", "external"]
    },
    "owner": { "type": "string" },
    "submitter": { "type": "string" },
    "summary": { "type": "string" },
    "proposed_team": {
      "type": "string",
      "pattern": "^team-[a-z][a-z0-9-]*$"
    },
    "proposed_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^label-[a-z][a-z0-9-]*$"
      }
    },
    "promoted_to_issue": {
      "type": "string",
      "pattern": "^mci-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "duplicate_of": {
      "type": "string",
      "pattern": "^(mci|tri)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "decision_reason": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
