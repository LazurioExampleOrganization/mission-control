{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmint.mission_control.update.v1",
  "title": "Mission Control update (status note / activity)",
  "description": "Human-readable status update attached to an issue, project, or initiative.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "entity_id",
    "author",
    "message",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentmint.mission_control.update.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^upd-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "entity_type": {
      "enum": ["issue", "project", "initiative", "cycle"]
    },
    "entity_id": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "message": { "type": "string", "minLength": 1 },
    "health": {
      "enum": ["on_track", "at_risk", "off_track"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
