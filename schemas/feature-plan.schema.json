{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmint.mission_control.feature_plan.v1",
  "title": "Mission Control feature plan",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "status",
    "owner",
    "created_at",
    "updated_at",
    "context",
    "goals",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "agentmint.mission_control.feature_plan.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^plan-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["strategy", "feature", "experiment", "ops", "decision"]
    },
    "status": {
      "enum": ["shaping", "ready", "in_progress", "blocked", "done", "archived"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "context": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": {
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "out": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "decision"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "decision": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "todo_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
      }
    },
    "planning_target": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace scope identifier or repo-relative path that hosts the TODO.tasks.json that should receive the exported tasks."
        },
        "todo_tasks_path": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path to the target TODO.tasks.json file."
        }
      },
      "additionalProperties": false
    },
    "proposed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["high", "medium", "low"] },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "risk_notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
