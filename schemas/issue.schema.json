{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmint.mission_control.issue.v1",
  "title": "Mission Control issue (work unit)",
  "description": "Concrete unit of work. Linear: Issue. ID prefix mci- to disambiguate from workspace ISSUES.open.json decisions.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "team_id",
    "workflow_id",
    "owner",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentmint.mission_control.issue.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^mci-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "minLength": 1,
      "description": "Workflow status id; resolved against referenced workflow."
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf-[a-z][a-z0-9-]*$"
    },
    "team_id": {
      "type": "string",
      "pattern": "^team-[a-z][a-z0-9-]*$"
    },
    "priority": {
      "enum": ["urgent", "high", "medium", "low", "none"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "assignee": { "type": "string" },
    "project_id": {
      "type": "string",
      "pattern": "^proj-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^cycle-[0-9]{4}-[0-9]{2}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^label-[a-z][a-z0-9-]*$"
      }
    },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "estimate": { "type": "number", "minimum": 0 },
    "due_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target_id"],
        "properties": {
          "type": {
            "enum": [
              "blocks",
              "blocked_by",
              "duplicates",
              "duplicate_of",
              "related"
            ]
          },
          "target_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "planning": {
      "type": "object",
      "properties": {
        "plan_id": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "source": { "type": "string" },
        "role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "todo_task_id": {
      "type": "string",
      "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$",
      "description": "Optional bridge to the matching TODO.tasks.json task id during compatibility window."
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
