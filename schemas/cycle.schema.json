{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmint.mission_control.cycle.v1",
  "title": "Mission Control cycle (execution interval)",
  "description": "Time-bounded execution interval. Linear: Cycle.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "starts_at",
    "ends_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentmint.mission_control.cycle.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^cycle-[0-9]{4}-[0-9]{2}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "team_id": {
      "type": "string",
      "pattern": "^team-[a-z][a-z0-9-]*$"
    },
    "status": {
      "enum": ["planned", "active", "completed", "canceled"]
    },
    "starts_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ends_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "summary": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mci-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
      }
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
