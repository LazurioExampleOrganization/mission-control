{
  "name": "mission-control-app-v3",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --no-env-file run src/server/main.ts",
    "start": "bun --no-env-file run src/server/main.ts",
    "dev:demo": "bun --no-env-file run src/server/demo.ts",
    "build": "bun ./node_modules/vite/bin/vite.js build",
    "check:prepared": "bun run src/prepared.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "bun test",
    "schema:export": "bun run src/cli/schema.ts --write",
    "schema:check": "bun run src/cli/schema.ts --check",
    "validate": "bun run src/cli/validate.ts",
    "validate:seed": "bun run src/cli/validate.ts --seed",
    "check": "bun run typecheck && bun run lint && bun run schema:check && bun run validate:seed && bun test"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@lazurio/module-kit": "github:Lazurio/module-kit#v0.2.0",
    "@lazurio/repository-db": "github:Lazurio/repository-db#v3.2.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "replace-with-org-slug-mission-control-v3",
      "title": "Mission Control",
      "description": "Plány, roadmapy a jejich publikování: data Organizace v repository-db.",
      "company": "REPLACE-WITH-ORG-NAME",
      "module": "mission-control",
      "surface": "internal",
      "dev_script": "dev",
      "start_script": "start",
      "build_script": "build",
      "build_output": "dist",
      "tags": [
        "mission-control",
        "planning",
        "repository-db"
      ],
      "listeners": [
        {
          "id": "web",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/healthz"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "app/v3/package.json",
      "check_script": "check:prepared"
    }
  }
}
