{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["bun-types"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": "."
  },
  "include": [
    "vite.config.ts",
    "src/server.ts",
    "src/prepared.ts",
    "src/store.ts",
    "src/validate.ts",
    "src/validate-cli.ts",
    "src/model.ts",
    "src/paths.ts",
    "src/create-plan.ts",
    "src/dev-code.ts",
    "src/export-todo.ts",
    "src/issue-resolution.ts",
    "src/agent-work-cli.ts",
    "src/work-board.ts",
    "src/roadmap-model.ts",
    "src/roadmaps.ts",
    "src/repository-api.ts",
    "src/repository-freshness-service.ts",
    "src/repository-freshness-worker.ts",
    "src/roadmap-step-draft.ts",
    "src/agent-work.ts",
    "src/plan-cli.ts",
    "src/proposals.ts",
    "src/vendor/mission-control-lib.ts",
    "src/vendor/proposals-lib.ts",
    "src/mission-control-pull.d.ts"
  ]
}
